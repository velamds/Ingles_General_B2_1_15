, {"content": "It", "type": "text"}]}, {"type": "post_question", "contents": {"content": "a challenging time for the family.", "type": ""}}, {"content": "secondary_2", "type": "objective"}], "id": 2}, {"responses": [{"correct": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "id": 0}, {"correct": 1, "_data": [{"content": "may have felt", "type": "text"}], "selected": 0, "id": 1}], "_data": [{"type": "question", "contents": [{"content": "engenn9le15ob08re4aud04", "type": "audio"}, {"content": "He", "type": "text"}]}, {"type": "post_question", "contents": {"content": "that this was another way of making a living. ", "type": ""}}, {"content": "secondary_2", "type": "objective"}], "id": 3}, {"responses": [{"correct": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "id": 0}, {"correct": 1, "_data": [{"content": "might not have realized", "type": "text"}], "selected": 0, "id": 1}, {"text": "", "correct": 0, "_data": [{"content": "may have to be", "type": "text"}], "selected": 0, "id": 2}], "_data": [{"type": "question", "contents": [{"content": "engenn9le15ob08re4aud05", "type": "audio"}, {"content": "They", "type": "text"}]}, {"type": "post_question", "contents": {"content": "they were watching the great Houdini.", "type": ""}}, {"content": "secondary_2", "type": "objective"}], "id": 4}], "_data": [{"type": "instructions", "contents": [{"content": " Let's <span class=\"tool-tip\" id=\"tip_3_0\">hypothesize</span> about Houdini. ", "type": "text"}]}, {"type": "group", "contents": [{"content": "Activity 2", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "L