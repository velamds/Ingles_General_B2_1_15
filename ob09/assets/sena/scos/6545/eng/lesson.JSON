{"content": "Writing", "type": "skill"}]}], "id": 9, "stimuli_ids": []}, {"template_override": 1, "type": "RSLT", "questions": [{"responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}], "id": 10, "stimuli_ids": []}, {"template_override": 1, "type": "DWS", "questions": [{"responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "_data": [{"type": "question", "contents": [{"content": "engenn9le15ob09re7pdf01.pdf", "type": "pdf"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": " Plan your escape!", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}]}], "id": 11, "stimuli_ids": []}], "stimuli": [{"template_override": 1, "_data": [], "type": "welcome", "contents": [{}], "id": 0}, {"template_override": 1, "_data": [], "type": "audio", "title": "", "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn9le15ob09re2aud01", "coverimg": "engenn9le15ob09re2img01.jpg", "images": [{"image": "engenn9le15ob09re2img01.jpg", "text": "", "id": 0, "time": "0"}, {"image": "engenn9le15ob09re2img01.jpg", "text": "In 1894, an acclaimed magician, Harry Houdini, met the love of his life, Wilhelmina Rahner (Bess for short), on Coney Island. After a brief courtship, they were married, and Houdini's assistant, Theo, was soon replaced by Bess in the magic act. For decades to come, she shared the spotlight with her husband.", "id": 1, "time": "100"}, {"image": "engenn9le15ob09re2img02.jpg", "text": "Early in his career, Houdini would bet his audience that he could escape any handcuffs they put on him. Eventually, he moved on to restraints such as coffins, straitjackets, and prison cells. He did all types of magic, but his grand escapes always stole the show. In 1899, a press agent discovered Houdini and he was soon booked into the biggest theaters in the country. The hype surrounding the famous escapist continued to grow, and his daring acts were always front-page news.", "id": 2, "time": "25000"}, {"image": "engenn9le15ob09re2img03.jpg", "text": "<p>Houdini's career was not limited to the stage. In fact, he was a jack-of-all-trades. In 1916, he ventured into the world of movies, and his visionary nature also found expression in his many writings.</p> One evening as Houdini was resting, a young man came into the theater dressing room. Houdini's ability to endure stomach punches was well known, and the visitor wanted to put it to the test. Without warning, Houdini was smacked in the gut. A week and a half later, on October 31, 1926, Houdini died from an infection in the lining of his stomach. The greatest escape artist of all times could not escape his death.", "id": 3, "time": "64000"}]}}], "id": 1}], "type": "scholar", "id": 0, "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}]}], "_data": [{"type": "metadata", "contents": [{"content": "Biographies", "type": "lesson_name"}, {"content": "Houdini in Coney Island", "type": "unit_name"}, {"content": 9, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 15, "type": "lesson"}, {"content": "B2.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Describe social, urban and environmental change in written and spoken situations according to work and social contexts.", "type": "primary"}, {"content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear", "type": "secondary_1"}, {"content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear", "type": "secondary_2"}, {"content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear", "type": "secondary_3"}, {"content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear", "type": "secondary_4"}, {"content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear", "type": "secondary_5"}, {"content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear", "type": "secondary_6"}, {"content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear", "type": "secondary_7"}, {"content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear", "type": "secondary_8"}]}, {"content": "engenn9le15ob09re1img01.jpg", "type": "background_image"}, {"type": "target_word", "contents": [{"content": "acclaimed", "type": "name"}, {"content": "praised by the public; respected", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: In 1894, acclaimed magician Harry Houdini met the love of his life.", "type": "example"}, {"content": "engenn9le15ob09aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use to talk about fame.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "share the spotlight", "type": "name"}, {"content": "to divide public attention between more than one person", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: For decades to come, she shared the spotlight with her husband.", "type": "example"}, {"content": "engenn9le15ob09aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to steal the show", "type": "name"}, {"content": "to attract the majority of the attention or praise", "type": "definition"}, {"content": "(expression) ", "type": "part_speech"}, {"content": "Example: His grand escapes always stole the show.", "type": "example"}, {"content": "engenn9le15ob09aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "hype", "type": "name"}, {"content": "intensive publicity or promotion", "type": "definition"}, {"content": "(noun) ", "type": "part_speech"}, {"content": "Example: The hype surrounding the famous escapist continued to grow.", "type": "example"}, {"content": "engenn9le15ob09aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "front-page news", "type": "name"}, {"content": "very important or noteworthy information", "type": "definition"}, {"content": "(expression) ", "type": "part_speech"}, {"content": "Example: His daring acts were always front-page news.", "type": "example"}, {"content": "engenn9le15ob09aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "visionary", "type": "name"}, {"content": " someone who can predict the future with great accuracy", "type": "definition"}, {"content": "(noun) ", "type": "part_speech"}, {"content": "Example: His visionary nature also found expression in his many writings.", "type": "example"}, {"content": "engenn9le15ob09aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "press agent", "type": "name"}, {"content": " a person who organizes promotions and publicity on behalf of a company or celebrity", "type": "definition"}, {"content": "(noun) ", "type": "part_speech"}, {"content": "Example: In 1899, a press agent discovered Houdini.", "type": "example"}, {"content": "engenn9le15ob09aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "jack of all trades", "type": "name"}, {"content": "a person who can do many different things", "type": "definition"}, {"content": "(expression) ", "type": "part_speech"}, {"content": "Example: He was a jack of all trades who dabbled in movies and writing.", "type": "example"}, {"content": "engenn9le15ob09aud08", "type": "audio"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I brainstorm an outline of how to get out of a locked room.", "type": "text"}, {"content": "I write a step-by-step plan.", "type": "text"}, {"content": "I share my plan with a partner.", "type": "text"}, {"content": "I speculate on what could have been done differently.", "type": "text"}]}, {"type": "takeaway_extension", "contents": [{"content": "Imagine that the door to the room that you are currently in is suddenly sealed shut.", "type": "text"}, {"content": "Brainstorm a list of ways that you could possibly escape the room.", "type": "text"}, {"content": "Make a quick sketch of the route you would take and the materials you would need.", "type": "text"}, {"content": "Write a step-by-step plan outlining your escape.", "type": "text"}, {"content": "Present your escape plan to your partner.", "type": "text"}, {"content": "Make suggestions to your partner using <span class=\"italic\">might have</span>, <span class=\"italic\">would have</span>, and <span class=\"italic\">could have</span>.", "type": "text"}]}, {"type": "learning_points", "contents": [{"content": "The Simple Past Passive", "type": "heading"}, {"content": "You use an <span class=\"strong\">active</span> structure when you want the 'doer' of the action to be the subject. </br>You use a <span class=\"strong\">passive</span> structure when you want the 'receiver' of the action to be the subject.  </br></br> You often choose the passive form when you want to talk about an action but are not so interested in saying who or what does/did it. Passives without <span class=\"italic\">agents</span> (the doers) are common in biographies. ", "type": "describer"}, {"content": "Active sentence = A fan (subject) <span class=\"strong\">smacked</span> Houdini (object) in the gut. <br/>Passive sentence = Houdini (subject) <span class=\"strong\">was smacked</span> in the gut <span class=\"underline\">by a fan</span> (agent).", "type": "text"}, {"content": "It is not necessary to mention the object in a passive sentence. ", "type": "text"}, {"content": "You make the passive form of a verb by using tenses of the verb <span class=\"strong\">to be</span> followed by the past participle. ", "type": "text"}, {"content": "{\"rows\":3,\"columns\":4,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">subject</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">was/were </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">past participle </span>\\\"}\",\"\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Houdini\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"was\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"booked\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"into the biggest theaters in the country.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"They\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"were\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"married\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"in 1894.\\\"}\"],\"styles\":\" intro_table_border\"}", "type": "table"}, {"content": "After a brief courtship, they were married, and Houdini's assistant, Theo, was soon replaced by Bess in the magic act.", "type": "example"}, {"content": "In 1899, a press agent discovered Houdini and he was soon booked into the biggest theaters in the country. ", "type": "example"}, {"content": "Houdini's ability to endure stomach punches was well known, and the visitor wanted to put it to the test.", "type": "example"}, {"content": "Without warning, Houdini was smacked in the gut.", "type": "example"}]}]}