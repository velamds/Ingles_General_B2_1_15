{"_data": [{"type": "metadata", "contents": [{"content": "Biographies", "type": "lesson_name"}, {"content": "The Cost of Fame", "type": "unit_name"}, {"content": 11, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 15, "type": "lesson"}, {"content": "B2.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Describe social, urban and environmental change in written and spoken situations according to work and social contexts.", "type": "primary"}, {"content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_1"}, {"content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_2"}, {"content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_3"}, {"content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_4"}, {"content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_5"}, {"content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_6"}, {"content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_7"}, {"content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_8"}]}, {"content": "engenn9le15ob11re1img01.jpg", "type": "background_image"}, {"type": "target_word", "contents": [{"content": "stardom", "type": "name"}, {"content": "the state of being famous", "type": "definition"}, {"content": "(noun) ", "type": "part_speech"}, {"content": "Example: Many celebrities could not have guessed the cost of their stardom.", "type": "example"}, {"content": "engenn9le15ob11aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use to talk about fame.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "career path", "type": "name"}, {"content": "the way you progress in your work, within a job or a series of jobs", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: He shouldn't have chosen such a challenging career path.", "type": "example"}, {"content": "engenn9le15ob11aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "humanitarian", "type": "name"}, {"content": "connected to improving human welfare or reducing suffering", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: Pavarotti was lauded by the press for performing humanitarian concerts.", "type": "example"}, {"content": "engenn9le15ob11aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "bad press", "type": "name"}, {"content": "when negative things are published about someone or something in a newspaper or on television", "type": "definition"}, {"content": "(noun) ", "type": "part_speech"}, {"content": "Example: Salvador Dali was labeled an eccentric and received more than his share of bad press.", "type": "example"}, {"content": "engenn9le15ob11aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "trailblazing", "type": "name"}, {"content": "being the first person to do something or go somewhere", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: Ada Lovelace was a trailblazing mathematician.", "type": "example"}, {"content": "engenn9le15ob11aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "rumor", "type": "name"}, {"content": "a story which is uncertain or untrue", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: She was hounded by rumor throughout her career.", "type": "example"}, {"content": "engenn9le15ob11aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "scandal", "type": "name"}, {"content": " public outrage caused by an illegal or immoral action", "type": "definition"}, {"content": "(noun) ", "type": "part_speech"}, {"content": "Example: Her outspoken attitude led to a few scandals.", "type": "example"}, {"content": "engenn9le15ob11aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "venerated", "type": "name"}, {"content": " extremely respected or honored", "type": "definition"}, {"content": "(adjective) ", "type": "part_speech"}, {"content": "Example: Even venerated celebrities are not immune.", "type": "example"}, {"content": "engenn9le15ob11aud08", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "sensationalized", "type": "name"}, {"content": "embellished in order to make more exciting but less accurate ", "type": "definition"}, {"content": "(adjective) ", "type": "part_speech"}, {"content": "Example: The bigger the star, the more sensationalized the rumors seem to be.", "type": "example"}, {"content": "engenn9le15ob11aud09", "type": "audio"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I use vocabulary about fame to write about the pros and cons of being famous.", "type": "text"}, {"content": "I expand my notes into complete sentences.", "type": "text"}, {"content": "I use <span class=\"italic\">must have</span>, <span class=\"italic\">may have</span>, <span class=\"italic\">might have</span>, and <span class=\"italic\">could have</span> to speculate about past, present, and future situations.", "type": "text"}, {"content": "I express my conclusions in a written paragraph.", "type": "text"}]}, {"type": "takeaway_extension", "contents": [{"content": "Make a chart with the word \u201cfame\u201d at the top.", "type": "text"}, {"content": "Create two subheadings, pros and cons.", "type": "text"}, {"content": "Using point form, list the pros and cons of being famous.", "type": "text"}, {"content": "Based on these notes, create a paragraph weighing both options.", "type": "text"}, {"content": "In your conclusion, state whether or not you would like to be famous. ", "type": "text"}]}, {"type": "learning_points", "contents": [{"content": "Passive Forms: Present Continuous, Present Perfect and Simple Past", "type": "heading"}, {"content": "You use an active structure when you want the 'doer' of the action to be the subject.</br></br> You use a passive structure when you want the 'receiver' of the action to be the subject.  </br></br> You often choose the passive form when you want to talk about an action but are not so interested in saying who or what does/did it. Passives without <span class=\"italic\">agents</span> (the doers) are common in biographies. ", "type": "describer"}, {"content": "You use the Simple Past to talk about a finished action at a particular time in the past. ", "type": "text"}, {"content": "<span class=\"italic\">The press<span class=\"strong\"> lauded</span> Pavarotti for performing humanitarian concerts.</span>", "type": "text"}, {"content": "You use the Present Continuous to talk about an action that is happening at the time of speaking. The action or event is in progress. </br><br/><span class=\"italic\"> To this day, people <span class=\"strong\"> are circulating</span> an urban legend about the burial of Walt Disney.<span class=\"italic\">", "type": "text"}, {"content": "You use the Present Perfect to talk about a finished action or event with present consequences. There is a connection between what happened in the past and the present. </br><br/><span class=\"italic\">People <span class=\"strong\">have said</span> that money doesn't buy happiness.</span>", "type": "text"}, {"content": "{\"rows\":4,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Name\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Structure\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Example\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Simple Past\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"was/were + past participle\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Pavarotti <span class=\\\"strong\\\">was lauded</span> by the press for performing humanitarian concerts.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Present Continuous\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"am/are/is +  being + past participle\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">To this day, an urban legend<span class=\\\"strong\\\"> is being circulated</span> about the burial of Walt Disney.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Present Perfect\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"have/has + been + past participle\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">It <span class=\\\"strong\\\">has been said</span> that \u201cmoney doesn't buy happiness.\u201d </span>\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}, {"content": "It has been said that \u201cmoney doesn't buy happiness.\u201d ", "type": "example"}, {"content": "Pavarotti was lauded by the press for performing humanitarian concerts aimed at raising money for people in areas of conflict. ", "type": "example"}, {"content": "Trailblazing mathematician Ada Lovelace was hounded by rumor and scandal throughout her entire career as a female in a male-dominated profession.", "type": "example"}, {"content": "To this day, an urban legend is being circulated about the burial of Walt Disney, who many people believe lies frozen under a ride at Disneyland. ", "type": "example"}, {"content": " It has been speculated that Wolfgang Amadeus Mozart could have been murdered by a jealous counterpart, and Harry Houdini is said to have been killed by an overzealous fan, who gave him a punch to the stomach.", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": "Speculation About the Past", "type": "heading"}, {"content": "You can use modals to talk about degrees of certainty and speculate about things in the past. </br>You use them to describe what is definite, probable, possible, or impossible from the speaker's point of view. ", "type": "describer"}, {"content": "You can use <span class=\"italic\">must</span>, <span class=\"italic\">may</span>, <span class=\"italic\">might</span>, and <span class=\"italic\">could</span> to describe degrees of certainty. </br>You can use modals with the Present Perfect to talk about the possibility of a past event that is not clear in the present context.", "type": "text"}, {"content": "Example:", "type": "text"}, {"content": "<span class=\"italic\">These libelous attacks <span class=\"strong\">must have been</span> a constant source of worry for the celebrities and their families. </span>", "type": "text"}, {"content": "Look at the chart for the meanings of modals when speculating about the past:", "type": "text"}, {"content": "{\"rows\":3,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Modal Phrase</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Meaning </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Must have\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"It is very likely.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"May have </br> Might have </br> Could have\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"It is possible.\\\"}\"],\"styles\":\" intro_table_border\"}", "type": "table"}, {"content": "<ul><li><span class=\"italic\">May have</span> has a slightly stronger meaning than <span class=\"italic\">might have</span> or<span class=\"italic\"> could have</span>.</li><li>You can add <span class=\"strong\">not</span> to make a negative speculation (It <span class=\"strong\">may not have been</span> true).</li></ul>", "type": "text"}, {"content": "In some cases, fame may have directly led to an untimely death. ", "type": "example"}, {"content": "It has been speculated that Wolfgang Mozart could have been murdered by a jealous counterpart.", "type": "example"}, {"content": "These libelous attacks must have been a constant source of worry for the celebrities and their families. ", "type": "example"}, {"content": "A good number of celebrated artists and thinkers might suggest that fame doesn't buy happiness either, and that had they known the costs of their stardom, they might have chosen a different career path altogether. ", "type": "example"}]}], "labs": [{"exercises": [{"template_override": 1, "_data": [{"type": "instructions", "contents": [{"content": " I can talk about what is being done or what has been done.", "type": "Learning Outcomes"}, {"content": " I can speculate about the past.", "type": "Learning Outcomes"}, {"content": " I can talk about what was done.", "type": "Learning Outcomes"}, {"content": " What do you think would be the best part of being famous? The worst?", "type": "Free Header Item"}, {"content": " If you could be a famous actor, musician or athlete, which one would you choose? Why?", "type": "Free Header Item"}]}, {"type": "group", "contents": [{"content": "Welcome", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "try again", "type": "text"}, {"content": "Maybe next time", "type": "text"}], "correct_feedback": "Correct", "attempt_feedback": [{"content": "You have 2 tries", "type": "text"}, {"content": "you have 1 attempt left", "type": "text"}]}, "type": "feedback"}, {"content": "Ask your partner:", "type": "free_header_text"}, {"content": "Let's review!", "type": "free_type_text_area"}], "img_path": "", "questions": [], "type": "WLC", "id": 0, "stimuli_ids": [0]}, {"template_override": 1, "type": "STI", "questions": [{"responses": [{"correct": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "id": 0}, {"correct": 1, "_data": [{"content": "", "type": "text"}], "selected": 0, "id": 1}], "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": " Fame may <span class=\"tool-tip\" id=\"tip_1_0\">not be all it's cracked up to be</span>!", "type": "text"}]}, {"type": "group", "contents": [{"content": "Content", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next tim